# ============================================================
#  JORS COSCA — Environment Configuration Template
#  Colegio de Santa Catalina de Alejandria (COSCA)
#
#  1. Copy this file:  cp .env.example .env
#  2. Fill in every value below.
#  3. NEVER commit the real .env to git — only .env.example.
# ============================================================

# ── PostgreSQL Database ──────────────────────────────────────
# Full connection URL format:
#   postgresql://<user>:<password>@<host>:<port>/<dbname>
# OR use the individual variables below.
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/jors_cosca

# Individual connection fields (used if DATABASE_URL is absent)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jors_cosca
DB_USER=postgres
DB_PASSWORD=yourpassword

# ── JWT Authentication ────────────────────────────────────────
# Generate a strong secret (run once):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_hex_string_at_least_64_chars

# ── Server ────────────────────────────────────────────────────
PORT=4000

# ── Google Gemini AI (optional) ───────────────────────────────
# If absent, the system falls back to rule-based analysis.
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Environment ───────────────────────────────────────────────
NODE_ENV=production
